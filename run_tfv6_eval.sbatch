#!/bin/bash
#SBATCH --job-name=tfv6_steering_eval
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=2-00:00:00
#SBATCH --gres=gpu:0

set -e

mkdir -p logs

# Make sure we are running from the project root
cd "$SLURM_SUBMIT_DIR"

source ~/miniconda3/etc/profile.d/conda.sh
conda activate fail2drive


export STEERING_POLICY="oracle"
export STEERING_ALPHA="1.0"

export ACTIVATION_POLICY=pdm_oracle
export PDM_ORACLE_ACTION=auto
export PDM_ORACLE_ALPHA=1.0
export BRAKE_ACTIVATION_ALPHA_SCALE=1.0
# export LEFT_ACTIVATION_ALPHA_SCALE=1.1  # For fused and decoder4
# export RIGHT_ACTIVATION_ALPHA_SCALE=1.1  # For fused and decoder4
export LEFT_ACTIVATION_ALPHA_SCALE=1.5  # For decoder5
export RIGHT_ACTIVATION_ALPHA_SCALE=1.5  # For decoder5

export PDM_ORACLE_TRIGGER_DISTANCE=20
export PDM_ORACLE_HOLD_FRAMES=31
export PDM_ORACLE_HOLD_FRAMES_BRAKE=31
export PDM_ORACLE_HOLD_FRAMES_LEFT=10
export PDM_ORACLE_HOLD_FRAMES_RIGHT=10
export PDM_ORACLE_COOLDOWN_FRAMES=10
export PDM_ORACLE_TWO_WAY_CLEAR_DISTANCE=70
export PDM_ORACLE_LANE_KEY_SEARCH_DISTANCE=100
export PDM_ORACLE_SIDE_HAZARD_DISTANCE=25
export PDM_ORACLE_SIDE_HAZARD_TWO_WAY_DISTANCE=10
export PDM_ORACLE_ROADBLOCKED_DISTANCE=50
export PDM_ORACLE_PRIORITY_DISTANCE=25
export PDM_ORACLE_YIELD_EMERGENCY_DISTANCE=50
export PDM_ORACLE_GENERAL_BRAKE=1

# Your existing environment variables
export CARLA_ROOT="$PWD/f2d_carla"
export LIVE_VISU=0
export DEBUG_CHALLENGE=0
export DEBUG_LOG_EGO_STAT=true
export ORACLE_VERBOSE=true

export STEERING_VECTORS_DIR="$PWD/steering/tfv6/post_process"

# export STEERING_FEATURE_NAME="fused_features"
# export STEERING_FEATURE_NAME_SHORT="fused"

# export STEERING_FEATURE_NAME="decoder_layer4"
# export STEERING_FEATURE_NAME_SHORT="decoder4"

export STEERING_FEATURE_NAME="decoder_layer5"
export STEERING_FEATURE_NAME_SHORT="decoder5"

# export STEERING_FEATURE_NAME="decoder_layer6"
# export STEERING_FEATURE_NAME_SHORT="decoder6"

env_cmd="export STEERING_FEATURE_NAME=$STEERING_FEATURE_NAME; export STEERING_POLICY=$STEERING_POLICY; export STEERING_ALPHA=$STEERING_ALPHA; export ACTIVATION_POLICY=$ACTIVATION_POLICY; export PDM_ORACLE_ACTION=$PDM_ORACLE_ACTION; export PDM_ORACLE_ALPHA=$PDM_ORACLE_ALPHA; export PDM_ORACLE_TRIGGER_DISTANCE=$PDM_ORACLE_TRIGGER_DISTANCE; export PDM_ORACLE_HOLD_FRAMES=$PDM_ORACLE_HOLD_FRAMES; export PDM_ORACLE_HOLD_FRAMES_BRAKE=$PDM_ORACLE_HOLD_FRAMES_BRAKE; export PDM_ORACLE_HOLD_FRAMES_LEFT=$PDM_ORACLE_HOLD_FRAMES_LEFT; export PDM_ORACLE_HOLD_FRAMES_RIGHT=$PDM_ORACLE_HOLD_FRAMES_RIGHT; export PDM_ORACLE_COOLDOWN_FRAMES=$PDM_ORACLE_COOLDOWN_FRAMES; export PDM_ORACLE_TWO_WAY_CLEAR_DISTANCE=$PDM_ORACLE_TWO_WAY_CLEAR_DISTANCE; export PDM_ORACLE_LANE_KEY_SEARCH_DISTANCE=$PDM_ORACLE_LANE_KEY_SEARCH_DISTANCE; export PDM_ORACLE_SIDE_HAZARD_DISTANCE=$PDM_ORACLE_SIDE_HAZARD_DISTANCE; export PDM_ORACLE_SIDE_HAZARD_TWO_WAY_DISTANCE=$PDM_ORACLE_SIDE_HAZARD_TWO_WAY_DISTANCE; export PDM_ORACLE_ROADBLOCKED_DISTANCE=$PDM_ORACLE_ROADBLOCKED_DISTANCE; export PDM_ORACLE_PRIORITY_DISTANCE=$PDM_ORACLE_PRIORITY_DISTANCE; export PDM_ORACLE_YIELD_EMERGENCY_DISTANCE=$PDM_ORACLE_YIELD_EMERGENCY_DISTANCE; export PDM_ORACLE_GENERAL_BRAKE=$PDM_ORACLE_GENERAL_BRAKE"
env_cmd="$env_cmd; export DEBUG_LOG_EGO_STAT=$DEBUG_LOG_EGO_STAT; export ORACLE_VERBOSE=$ORACLE_VERBOSE; BRAKE_ACTIVATION_ALPHA_SCALE=$BRAKE_ACTIVATION_ALPHA_SCALE; LEFT_ACTIVATION_ALPHA_SCALE=$LEFT_ACTIVATION_ALPHA_SCALE; RIGHT_ACTIVATION_ALPHA_SCALE=$RIGHT_ACTIVATION_ALPHA_SCALE"

python -u slurm_evaluate.py \
  --routes fail2drive_split \
  --seeds 3 \
  --retries 1 \
  --out_root results/tfv6_$STEERING_FEATURE_NAME_SHORT \
  --agent_file "$LEAD_ROOT/lead/inference/sensor_agent.py" \
  --agent_config "$LEAD_ROOT/outputs/checkpoints/tfv6_resnet34" \
  --lb_script leaderboard/leaderboard/leaderboard_evaluator_local.py \
  --env_var_cmd "$env_cmd"
